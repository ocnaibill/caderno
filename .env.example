# Copie pra .env e preencha (.env já está no .gitignore).

# Resend (https://resend.com) — envio de e-mail das edições e, no futuro,
# da confirmação de assinatura (double opt-in). Sem isso, as rotas de
# disparo retornam erro 503 em vez de falhar silenciosamente.
RESEND_API_KEY=
RESEND_FROM=

# Porta do servidor Bun (opcional, default 3000)
# PORT=3000

# Caminho do banco SQLite (opcional, default data/caderno.sqlite)
# CADERNO_DB_PATH=data/caderno.sqlite
