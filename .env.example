# Copie pra .env e preencha (.env já está no .gitignore).

# Resend (https://resend.com) — envio de e-mail das edições e, no futuro,
# da confirmação de assinatura (double opt-in). Sem isso, as rotas de
# disparo retornam erro 503 em vez de falhar silenciosamente.
RESEND_API_KEY=
RESEND_FROM=

# Painel administrativo (/escrever, /comentarios/moderar, disparo de
# e-mail) — HTTP Basic. SEM ISSO, essas rotas ficam desligadas (503), não
# abertas. Obrigatório antes de ir pro homelab.
ADMIN_USER=
ADMIN_PASSWORD=

# URL pública do site (sem barra no final) — usada em canonical, og:url,
# RSS e nos links de gerenciar/cancelar assinatura dentro dos e-mails.
# Sem isso, cai no placeholder do domínio do homelab em src/config.ts.
CADERNO_URL=

# Porta do servidor Bun (opcional, default 3000)
# PORT=3000

# Caminho do banco SQLite (opcional, default data/caderno.sqlite)
# CADERNO_DB_PATH=data/caderno.sqlite
